# Copy this file to ".env" and fill in your own values. Never commit .env.
# Leave SUPABASE_URL and SUPABASE_KEY empty to keep data in a local file on this computer.

# Supabase: Project Settings > API
SUPABASE_URL=
SUPABASE_KEY=

# Optional shared password for the app. Set one before sharing a public link.
APP_PASSWORD=

# Optional
DEMO_CATEGORY=Beverages
CURRENCY_SYMBOL=₱
BALANSE_LOCAL_DB=balanse_local.db
